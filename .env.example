# Example local environment for the sample service and pipeline helpers.
# Copy to .env for local runs only. NEVER commit a real .env.
#
# In CI, these values come from the CI system's variable store:
#   - Secrets (tokens, registry passwords) are MASKED and PROTECTED.
#   - Protected variables are only exposed to protected branches/tags
#     and to the manually approved promotion jobs.
# Hostnames below are documentation placeholders, not real systems.

# --- Sample service ---
PORT=8080
SERVICE_VERSION=0.1.0

# --- Container registry ---
# Image is built once as:
#   $CI_REGISTRY_IMAGE:$IMAGE_TAG        (built artifact, e.g. dev-<sha>)
# and addressed by digest for scanning and promotion.
CI_REGISTRY=registry.example.internal
CI_REGISTRY_IMAGE=registry.example.internal/team/sample-service
CI_REGISTRY_USER=ci-service-account
CI_REGISTRY_PASSWORD=

# --- SonarQube (quality gate) ---
SONAR_HOST_URL=https://sonar.example.internal
SONAR_TOKEN=
SONAR_PROJECT_KEY=sample-service

# --- Anchore / Grype (image vulnerability scan) ---
# Fail the pipeline on fixable vulnerabilities at or above this severity.
ANCHORE_FAIL_SEVERITY=high

# --- OpenSCAP (compliance scan) ---
OSCAP_PROFILE=xccdf_org.ssgproject.content_profile_cis
OSCAP_SCANNER_IMAGE=openscap-scanner:1.3

# --- Promotion (set by the pipeline; shown here for local dry-runs) ---
# IMAGE_REF=registry.example.internal/team/sample-service@sha256:<digest>
# IMAGE_TAG=dev-abc1234
# TARGET_ENV=stage
# GATE_STATUS_FILE=gate-status.env
# PROMOTE_APPROVED=true   # only ever set inside an approved job
# DRY_RUN=true            # local testing of scripts/promote.sh
